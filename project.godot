; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="CrusaderClonists"
config/description="6v6 third-person shooter with MOBA lanes and RTS bases (Crusaders + Colonist)."
run/main_scene="res://game/match.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="CrusaderClonists"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="characters"
3d_physics/layer_3="items"
3d_physics/layer_4="projectiles"
3d_physics/layer_5="boundary"
3d_physics/layer_6="units_team0"
3d_physics/layer_7="units_team1"
3d_physics/layer_8="heroes_team0"
3d_physics/layer_9="heroes_team1"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

rendering_device/driver.windows="d3d12"
